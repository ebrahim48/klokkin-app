<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Klokkin App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>klokkin_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- ==================== PRIVACY PERMISSIONS ==================== -->

	<!-- CAMERA PERMISSION -->
	<!-- Required for: camera package, image_picker (ImageSource.camera) -->
	<!-- Used in: VideoCreateStoryScreen for recording videos, UploadCreateStoryController for taking photos -->
	<key>NSCameraUsageDescription</key>
	<string>Klokkin needs camera access to record videos and take photos for creating stories.</string>

	<!-- MICROPHONE PERMISSION -->
	<!-- Required for: record package (audio recording), camera package (video with audio) -->
	<!-- Used in: RecordStoryController for voice recordings, VideoCreateStoryScreen for video with sound -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Klokkin needs microphone access to record audio stories and capture sound in videos.</string>

	<!-- PHOTO LIBRARY READ PERMISSION -->
	<!-- Required for: image_picker (ImageSource.gallery), file_picker -->
	<!-- Used in: UploadCreateStoryController for picking images/videos, profile photo selection -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Klokkin needs access to your photo library to select images and videos for your stories.</string>

	<!-- PHOTO LIBRARY WRITE PERMISSION -->
	<!-- Required for: image_gallery_saver_plus -->
	<!-- Used in: DownloadService for saving downloaded media to the device -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Klokkin needs permission to save downloaded images and videos to your photo library.</string>
</dict>
</plist>
